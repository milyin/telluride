# Telegram Bot Token (from @BotFather)
TELOXIDE_TOKEN=your_bot_token_here

# Google Service Account credentials JSON file path
# Create a service account in Google Cloud Console, download the JSON key,
# and share your Google Spreadsheet with the service account email.
GOOGLE_CREDENTIALS_PATH=credentials.json

# Google Spreadsheet ID
# The ID is the long string in the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Log level (trace, debug, info, warn, error)
RUST_LOG=info
