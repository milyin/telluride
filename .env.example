# Deployment Configuration
# Copy this file to .env and fill in your values
# WARNING: Do not commit .env to version control

# SSH user for deployment
DEPLOY_USER=your_username

# Deployment host/server
DEPLOY_HOST=your_server.example.com

# Path on the remote server where the bot directory should be created/updated
DEPLOY_PATH=/home/your_username/simple_bot

# Telegram Bot Token (will be passed to the remote process)
TELOXIDE_TOKEN=your_telegram_bot_token

# Build target (default: x86_64-unknown-linux-gnu for typical Linux servers)
# Ensure you have the target installed via: rustup target add x86_64-unknown-linux-gnu
BUILD_TARGET=x86_64-unknown-linux-gnu

# Build flags (e.g. --release). Leave empty for debug build.
# CARGO_BUILD_FLAGS=--release
